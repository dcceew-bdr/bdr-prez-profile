@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ont: <https://prez.dev/ont/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix customendpoints: <https://prez/custom-endpoints/> .

<https://prez/custom-endpoints> {

customendpoints:catalogues-listing a ont:DynamicEndpoint, ont:ListingEndpoint ;
    rdfs:label "Catalogues Listing" ;
    ont:apiPath "/catalogues" ;
    ont:relevantShapes customendpoints:shape-R0-HL1 .

customendpoints:catalogues-object a ont:DynamicEndpoint, ont:ObjectEndpoint ;
    rdfs:label "Catalogues Object" ;
    ont:apiPath "/catalogues/{catalogueId}" ;
    ont:relevantShapes customendpoints:shape-R0-HL1 .

customendpoints:collections-listing a ont:DynamicEndpoint, ont:ListingEndpoint ;
    rdfs:label "Collections Listing" ;
    ont:apiPath "/catalogues/{catalogueId}/collections" ;
    ont:relevantShapes customendpoints:shape-R0-HL2-L .

# customendpoints:subcatalogues-listing a ont:DynamicEndpoint, ont:ListingEndpoint ;
#     rdfs:label "Subcatalogues Listing" ;
#     ont:apiPath "/catalogues/{catalogueId}/catalogues" ;
#     ont:relevantShapes customendpoints:shape-R0-HL2-2 .

customendpoints:collections-object a ont:DynamicEndpoint, ont:ObjectEndpoint ;
    rdfs:label "Collections Object" ;
    ont:apiPath "/catalogues/{catalogueId}/collections/{recordsCollectionId}" ;
    ont:relevantShapes customendpoints:shape-R0-HL2-O .

# customendpoints:subcatalogues-object a ont:DynamicEndpoint, ont:ObjectEndpoint ;
#     rdfs:label "Subcatalogues Listing" ;
#     ont:apiPath "/catalogues/{catalogueId}/catalogues/{subcatalogueId}" ;
#     ont:relevantShapes customendpoints:shape-R0-HL2-2 .

customendpoints:items-listing a ont:DynamicEndpoint, ont:ListingEndpoint ;
    rdfs:label "Items Listing" ;
    ont:apiPath "/catalogues/{catalogueId}/collections/{recordsCollectionId}/items" ;
    ont:relevantShapes customendpoints:shape-R0-HL3, customendpoints:shape-R0-HL3-1 .

customendpoints:items-object a ont:DynamicEndpoint,ont:ObjectEndpoint ;
    rdfs:label "Items Object" ;
    ont:apiPath "/catalogues/{catalogueId}/collections/{recordsCollectionId}/items/{itemId}" ;
    ont:relevantShapes customendpoints:shape-R0-HL3, customendpoints:shape-R0-HL3-1 .

customendpoints:shape-R0-HL1 a sh:NodeShape ;
    sh:targetClass dcat:Catalog , schema:DataCatalog ;
    sh:property [
      sh:path [ sh:alternativePath ( [ sh:inversePath dcterms:isPartOf ] dcterms:hasPart [ sh:inversePath schema:isPartOf ] schema:hasPart )] ;
      sh:or ( [ sh:class schema:DataCatalog ] [ sh:class dcat:Catalog ] [ sh:class skos:Collection ] [ sh:class schema:Dataset ] [ sh:class schema:Resource ] [ sh:class skos:ConceptScheme ] )
    ] ;
    ont:hierarchyLevel 1 .

customendpoints:shape-R0-HL2-L a sh:NodeShape ;
    # For listings, include Catalogs in hierarchy level 2
    sh:targetClass skos:Collection,
        skos:ConceptScheme,
        dcat:Catalog,
        schema:Dataset ,
        schema:DataCatalog ,
        schema:Resource ;
    sh:property [
      sh:path [ sh:alternativePath ( [ sh:inversePath dcterms:hasPart ] dcterms:isPartOf [ sh:inversePath schema:hasPart ] schema:isPartOf )] ;
      sh:or ( [ sh:class dcat:Catalog ] [sh:class schema:DataCatalog] )
    ] ;
    ont:hierarchyLevel 2 .

customendpoints:shape-R0-HL2-O a sh:NodeShape ;
    # For objects, don't generate links to hierarchy level 2 for Catalogs
    sh:targetClass skos:Collection,
        skos:ConceptScheme,
        schema:Dataset ,
        schema:Resource ;
    sh:property [
      sh:path [ sh:alternativePath ( [ sh:inversePath dcterms:hasPart ] dcterms:isPartOf [ sh:inversePath schema:hasPart ] schema:isPartOf )] ;
      sh:or ( [ sh:class dcat:Catalog ] [sh:class schema:DataCatalog] )
    ] ;
    ont:hierarchyLevel 2 .


# customendpoints:shape-R0-HL2-2 a sh:NodeShape ;
#     sh:targetClass dcat:Catalog,
#         schema:DataCatalog;
#     sh:property [
#       sh:path [ sh:alternativePath ( [ sh:inversePath dcterms:hasPart ] dcterms:isPartOf [ sh:inversePath schema:hasPart ] schema:isPartOf )] ;
#       sh:or ( [ sh:class dcat:Catalog ] [sh:class schema:DataCatalog] )
#     ] ;
#     ont:hierarchyLevel 2 .

customendpoints:shape-R0-HL3 a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property [
        sh:or ( [ sh:class dcat:Catalog ] [sh:class schema:DataCatalog] ) ;
        sh:path ( skos:inScheme [ sh:alternativePath ( [ sh:inversePath dcterms:hasPart ] dcterms:isPartOf [ sh:inversePath schema:hasPart ] schema:isPartOf )] )
    ],
    [
        sh:class skos:ConceptScheme ;
        sh:path skos:inScheme
    ] ;
    ont:hierarchyLevel 3 .

customendpoints:shape-R0-HL3-1 a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property [
        sh:class skos:Collection ;
        sh:path [ sh:inversePath skos:member ]
    ],
    [
        sh:or ( [ sh:class dcat:Catalog ] [sh:class schema:DataCatalog] ) ;
        sh:path ( [ sh:inversePath skos:member ] [ sh:alternativePath ( [ sh:inversePath dcterms:hasPart ] dcterms:isPartOf [ sh:inversePath schema:hasPart ] schema:isPartOf )] )
    ] ;
    ont:hierarchyLevel 3 .
}